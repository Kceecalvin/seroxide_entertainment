# Copy to .env and fill in for your environment. Never commit the real .env file.

SECRET_KEY=change-me-to-a-long-random-string
# Generate one, e.g.: python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"

SITE_NAME=SeroTix
SITE_TAGLINE=Tickets to Kenya's best nights out.
SITE_DOMAIN=serotix.co.ke
SITE_SUPPORT_EMAIL=support@serotix.co.ke
SITE_SUPPORT_PHONE=+254 700 000000

# --- Transactional email (Brevo SMTP, or any SMTP provider) ---
# Required in production — config/settings/prod.py refuses to start without these,
# since a missing/wrong value here means ticket confirmations and the contact
# form silently fail (no error, just no email ever sent).
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1

# --- M-Pesa Daraja API ---
# In production ALL of MPESA_CONSUMER_KEY / MPESA_CONSUMER_SECRET / MPESA_PASSKEY /
# MPESA_CALLBACK_URL / MPESA_CALLBACK_TOKEN are required — config/settings/prod.py
# refuses to start without them (see the security notes in the project README/PR).
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
# Base URL only — the secret token below is appended automatically (apps/payments/mpesa.py).
MPESA_CALLBACK_URL=https://your-domain/payments/mpesa/callback
# Random secret that gates the callback URL, since Safaricom's webhook has no auth of its
# own. Generate with: python -c "from django.utils.crypto import get_random_string as g; print(g(40))"
MPESA_CALLBACK_TOKEN=

# Local development only — never set this in production (prod.py will refuse to start if it is).
# Defaults to "1" in config/settings/dev.py so checkout works instantly with no live credentials.
# MPESA_SIMULATE=1

# --- Production only ---
DJANGO_ALLOWED_HOSTS=serotix.co.ke,www.serotix.co.ke

# Set this to the number of reverse-proxy hops in front of the app that
# actually append to X-Forwarded-For (e.g. 1 behind a single nginx/load
# balancer). Leave at 0 (default) unless you've confirmed that topology —
# an incorrect value makes apps/core/ratelimit.py's IP-based throttling
# spoofable by anyone who sets their own X-Forwarded-For header.
TRUSTED_PROXY_COUNT=1  # nginx is the one reverse-proxy hop in front of gunicorn — see deploy/nginx.conf

# Required in production — config/settings/prod.py refuses to start on SQLite,
# since select_for_update() row locks (used for stock reservation and payment
# idempotency) are a silent no-op on SQLite's single-writer engine.
DATABASE_URL=postgres://user:password@host:5432/serotix

REDIS_URL=redis://127.0.0.1:6379/1
# Keep disabled until the owner approves live merchant credentials and acceptance.
# Production checkout independently rejects sandbox M-Pesa and test Paystack keys.
PAYMENTS_LIVE=0
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
# Legacy Stripe callback/refund support only; not offered for new checkouts.
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SERVICE_FEE_PERCENT=0.08
# Never enable any simulation in production, including retired Flutterwave.
MPESA_SIMULATE=0
PAYSTACK_SIMULATE=0
STRIPE_SIMULATE=0
FLUTTERWAVE_SIMULATE=0
