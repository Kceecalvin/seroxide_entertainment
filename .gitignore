# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# IDE-specific files (optional, depending on what you use)
.vscode/
.idea/

# Environment files — DO NOT COMMIT SECRETS! (gitignore has no inline-comment
# syntax; a trailing comment on the same line as a pattern becomes part of the
# literal pattern and silently stops it from matching anything.)
.env
.env.*
!.env.example

# Django stuff:
*.log
local_settings.py
db.sqlite3
/media/
/staticfiles/

# Virtual environment
/venv/
/env/

# Frontend tooling; compiled static/dist assets are shipped with Django.
/node_modules/
/frontend/build-meta.json
/test-results/
/playwright-report/
/.claude/
/.mcp.json
/handover/
