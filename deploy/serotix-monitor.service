[Unit]
Description=Check SeroTix database/cache and payment reconciliation
After=network.target postgresql.service
[Service]
Type=oneshot
User=serotix
Group=serotix
WorkingDirectory=/srv/serotix/app
EnvironmentFile=/srv/serotix/app/.env
Environment=DJANGO_SETTINGS_MODULE=config.settings.prod
ExecStart=/srv/serotix/venv/bin/python /srv/serotix/app/manage.py production_status --check
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
