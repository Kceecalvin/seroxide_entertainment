[Unit]
Description=SeroTix private database and media backup
After=postgresql.service
[Service]
Type=oneshot
User=serotix
Group=serotix
UMask=0077
ExecStart=/bin/bash /srv/serotix/app/deploy/backup-full.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/srv/serotix/backups
