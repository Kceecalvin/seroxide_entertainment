[Unit]
Description=Release stock reserved by stale pending SeroTix orders
After=network.target postgresql.service

[Service]
Type=oneshot
User=serotix
Group=serotix
WorkingDirectory=/srv/serotix/app
EnvironmentFile=/srv/serotix/app/.env
# manage.py defaults to config.settings.dev (SQLite) unless told otherwise —
# unlike config/wsgi.py, which hardcodes prod. Missing this would silently
# run the cleanup against an empty dev DB instead of the real one.
Environment=DJANGO_SETTINGS_MODULE=config.settings.prod
ExecStart=/srv/serotix/venv/bin/python /srv/serotix/app/manage.py expire_stale_orders

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
